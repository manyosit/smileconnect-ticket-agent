    "options": {
      "dateFormat": "",
      "allowDynamicImpersonate": true,
      "translateSelectionFields": true,
      "documentationLink": "https://smileconnect.manyosdocs.de/#/configuration/scriptEndpoints",
      "openAPIDescription": "SMILEconnect interface for autonomous AI agents: incident processing (read, worklogs, resolve), CMDB read access and agent-specific script endpoints (assign to me, my incidents, escalate)."
    },
    "scriptEndpoints": {
      "getMyIncidents": {
        "options": {
          "openAPISpec": {
            "summary": "Get my incidents",
            "decription": "Returns the open incidents assigned to the currently authenticated user (the impersonated identity), with all fields mapped for this client. Takes no parameters — the user is always the caller and cannot be chosen. Use this to see your own workload or to check which tickets you are responsible for.",
            "requestSchema": {
              "type": "object",
              "properties": {}
            },
            "responseSchema": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "scripts": [
          "getMyIncidents"
        ]
      },
      "assignIncidentToMe": {
        "options": {
          "openAPISpec": {
            "summary": "Assign an incident to the current user",
            "decription": "Assigns the given incident to the currently authenticated user (the impersonated identity) and sets the status to In Progress. Use this to take ownership of a ticket before working on it — for example when you decide to solve an incident yourself. Requires only the incident number; the assignee is always the current user and cannot be chosen.",
            "requestSchema": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The incident number to assign, e.g. INC000000001401"
                }
              }
            },
            "responseSchema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The incident number"
                },
                "status": {
                  "type": "string"
                },
                "assignee": {
                  "type": "string",
                  "description": "The user the incident was assigned to"
                },
                "assignedGroup": {
                  "type": "string"
                }
              }
            }
          }
        },
        "scripts": [
          "assignIncidentToMe"
        ]
      },
      "escalateTicket": {
        "options": {
          "openAPISpec": {
            "summary": "Escalate a ticket to the agent's support group",
            "decription": "Escalates an incident: assigns it to the support group configured for the calling agent (server-side mapping, the caller cannot choose the group) and sets the status to Assigned. Use this when a ticket cannot be solved or an action failed. Requires only the incident number.",
            "requestSchema": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The incident number to escalate, e.g. INC000000001401"
                }
              }
            },
            "responseSchema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "escalatedBy": {
                  "type": "string"
                },
                "assignedGroup": {
                  "type": "string"
                }
              }
            }
          }
        },
        "scripts": [
          "escalateTicket"
        ]
      }
    }
