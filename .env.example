# =============================================================================
# SmileConnect Ticket Agent – Template-Konfiguration
# Kopieren nach .env und ausfüllen. Setup-Schritte: siehe README.md
# =============================================================================

# --- Agent-Identität (SSO) ----------------------------------------------------
# Der Agent holt sich seine Tokens selbst bei der Kunden-SSO. Zwei Modelle:
#
# Modell 1 – eigener Client pro Agent (TOKEN_GRANT=client_credentials):
#   SmileConnect-Client-Config des Agenten setzt statisch
#   options.impersonateUser = <Remedy-User>.
#
# Modell 2 – gemeinsamer Client, eigener SSO-Service-User pro Agent
#   (TOKEN_GRANT=password): SmileConnect-Client hat allowDynamicImpersonate:
#   true; die Identität kommt aus dem SSO-verifizierten preferred_username.
#   Zusätzlich AGENT_USERNAME/AGENT_PASSWORD setzen.
SSO_TOKEN_URL=https://sso.customer.com/realms/itsmproxy/protocol/openid-connect/token
TOKEN_GRANT=client_credentials
AGENT_CLIENT_ID=agent-ticketsolver
AGENT_CLIENT_SECRET=...
# Nur für Modell 2 (TOKEN_GRANT=password):
# AGENT_USERNAME=svc-agent-1
# AGENT_PASSWORD=...

# --- SmileConnect MCP Server --------------------------------------------------
MCP_SERVER_URL=https://smileconnect-mcp.customer.com/mcp

# --- LLM (OpenAI-kompatible API, z.B. LiteLLM-Gateway) ------------------------
# Base-URL des Gateways (LiteLLM: https://litellm.customer.com; der /v1-Pfad
# wird vom SDK ergänzt bzw. kann mit angegeben werden) + Virtual Key.
LLM_BASE_URL=https://litellm.customer.com/v1
LLM_API_KEY=sk-...
# Modellname, wie im Gateway konfiguriert (z.B. claude-opus-5, gpt-4.1, ...)
LLM_MODEL=claude-opus-5

# --- Webhook (wird vom SMILEconnect QueueData Outgoing-Event aufgerufen) ------
AGENT_PORT=4100
# Feldname im Event-Payload, der die Ticket-Nummer enthält
TICKET_ID_FIELD=ticketNumber
# Optional: Shared Secret; wenn gesetzt, muss das Event den Header
# "x-agent-token: <wert>" mitschicken
WEBHOOK_TOKEN=

# --- Eskalation ---------------------------------------------------------------
# Freitext-Anweisung, WIE eskaliert wird. Wird in den System-Prompt eingesetzt.
# Standard: der SmileConnect-ScriptEndpoint escalateTicket (siehe
# smileconnect/CONFIG.md) — die Zielgruppe bestimmt das Script serverseitig
# anhand des Agenten-Users.
# Alternative ohne ScriptEndpoint:
#   "Setze per Ticket-Update assignedGroup auf 'Service Desk'."
ESCALATION_INSTRUCTION=Rufe das Tool run_escalateTicket mit der Incident-Nummer auf.

# --- Test/Entwicklung ---------------------------------------------------------
# DRY_RUN=true  → kein LLM-Call; Kette Webhook→Token→MCP→Tools wird getestet
DRY_RUN=false
